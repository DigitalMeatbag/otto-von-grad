{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "VS2026 · CUDA · Release",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "OVG_CUDA": "ON",
        "CMAKE_CONFIGURATION_TYPES": "Release"
      }
    },
    {
      "name": "debug",
      "displayName": "VS2026 · CUDA · Debug",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release;Debug"
      }
    },
    {
      "name": "cpu",
      "displayName": "VS2026 · CPU-only · Release",
      "inherits": "default",
      "cacheVariables": {
        "OVG_CUDA": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "displayName": "Build Release",
      "configurePreset": "default",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "displayName": "Build Debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "cpu",
      "displayName": "Build CPU-only Release",
      "configurePreset": "cpu",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "configuration": "Release"
    }
  ]
}
